68]:\n          - link \" 创作者中心\" [ref=e69] [cursor=pointer]:\n            - /url: https://mp.xueqiu.com/\n            - generic [ref=e70]: \n            - generic [ref=e71]: 创作者中心\n        - listitem [ref=e72]:\n          - link \"我的消息\" [ref=e73] [cursor=pointer]:\n            - /url: javascript:;\n            - img [ref=e74]\n            - generic [ref=e75]: 我的消息\n          - list [ref=e76]:\n            - listitem [ref=e77]:\n              - link \"回复\" [ref=e78] [cursor=pointer]:\n                - /url: /center/#/comments?t=1773292887600\n            - listitem [ref=e79]:\n              - link \"@我\" [ref=e80] [cursor=pointer]:\n                - /url: /center/#/mention?t=1773292887600\n            - listitem [ref=e81]:\n              - link \"赞\" [ref=e82] [cursor=pointer]:\n                - /url: /center/#/likes?t=1773292887600\n            - listitem [ref=e83]:\n              - link \"我的粉丝\" [ref=e84] [cursor=pointer]:\n                - /url: /center/#/fans?t=1773292887600\n            - listitem [ref=e85]:\n              - link \"系统消息 150\" [ref=e86] [cursor=pointer]:\n                - /url: /center/#/sys-message\n                - text: 系统消息\n                - generic [ref=e87]: \"150\"\n            - listitem [ref=e88]:\n              - link \"私信\" [ref=e89] [cursor=pointer]:\n                - /url: /center/#/user-message\n    - generic [ref=e90]:\n      - generic [ref=e91]:\n        - generic [ref=e92]:\n          - link \"天时地利的迷信\" [ref=e93] [cursor=pointer]:\n            - /url: /5644376051\n            - img \"天时地利的迷信\" [ref=e94]\n          - link \"天时地利的迷信\" [ref=e96] [cursor=pointer]:\n            - /url: /5644376051\n          - generic [ref=e97]:\n            - link \"发布于2026-02-04 11:42\" [ref=e98] [cursor=pointer]:\n              - /url: /5644376051/374795050\n              - text: 发布于\n              - time [ref=e99]: 2026-02-04 11:42\n            - generic [ref=e100]:\n              - text: 来自\n              - link \"Android\" [ref=e101] [cursor=pointer]:\n                - /url: http://xueqiu.com/about/mobile-xueqiu\n            - text: ·\n            - generic [ref=e102]: 广东\n          - generic [ref=e103] [cursor=pointer]: 关注\n        - article [ref=e104]:\n          - heading \"印尼煤出口限制带动煤炭板块大涨 ， 华阳今天走得偏弱 ， 说说个人看法：\" [level=1] [ref=e105]:\n            - text: 印尼煤出口限制带动煤炭板块大涨\n            - generic [ref=e107]: ，\n            - text: 华阳今天走得偏弱\n            - generic [ref=e109]: ，\n            - text: 说说个人看法\n            - generic [ref=e110]: ：\n          - paragraph [ref=e112]:\n            - text: 今天的走势其实不难理解\n            - generic [ref=e114]: ，\n            - text: 华阳的资金构成本身就比较复杂\n            - generic [ref=e116]: ，\n            - text: 一部分资金炒碳纤维\n            - generic [ref=e118]: ，\n            - text: 一部分看\n            - link \"新能源\" [ref=e119] [cursor=pointer]:\n              - /url: https://xueqiu.com/S/SH000941?from=status_stock_match\n            - generic [ref=e121]: ，\n            - text: 反而纯炒煤价回升的资金占比不高\n            - generic [ref=e123]: 。\n            - text: 今天商业航空板块下跌\n            - generic [ref=e125]: ，\n            - text: 碳纤维相关情绪受影响\n            - generic [ref=e127]: ，\n            - text: 叠加股价到了前高附近\n            - generic [ref=e129]: ，\n            - text: 资金有犹豫\n            - generic [ref=e131]: 、\n            - text: 出现停顿都很正常\n            - generic [ref=e133]: 。\n            - text: 再加上从去年到现在华阳已有不少涨幅\n            - generic [ref=e135]: ，\n            - text: 部分资金获利了结\n            - generic [ref=e137]: ，\n            - text: 成交量放大其实是正常的洗盘动作\n            - generic [ref=e139]: ，\n            - text: 不用过度解读\n            - generic [ref=e140]: 。\n            - text: 但大家其实都忽略了\n            - generic [ref=e142]: ，\n            - text: 华阳的煤炭基本盘才是真的硬\n            - generic [ref=e143]: ！\n            - text: 作为无烟煤龙头\n            - generic [ref=e145]: ，\n            - text: 公司长短期煤炭增量都确定\n            - generic [ref=e147]: ，\n            - text: 平舒\n            - generic [ref=e149]: 、\n            - text: 榆树坡矿核增后产能大幅提升\n            - generic [ref=e151]: ，\n            - text: 七元矿\n            - generic [ref=e153]: 、\n            - text: 泊里矿也陆续爬坡\n            - generic [ref=e155]: ，\n            - text: 还有去年68亿竞得于家庄优质无烟煤探矿权\n            - generic [ref=e157]: ，\n            - text: 新增6.3亿吨资源\n            - generic [ref=e159]: ，\n            - text: 在上市公司里这波资源收购的成本和质量都很有优势\n            - generic [ref=e161]: ，\n            - text: 后续煤炭业务的盈利弹性十足\n            - generic [ref=e163]: 。\n            - text: 印尼煤出口限制带来的煤价利好\n            - generic [ref=e165]: ，\n            - text: 华阳的煤炭业务必然会充分受益\n            - generic [ref=e167]: ，\n            - text: 只是短期被其他概念掩盖了而已\n            - generic [ref=e168]: 。\n            - text: 碳纤维这边也不用慌\n            - generic [ref=e170]: ，\n            - text: T1000级已经稳定量产\n            - generic [ref=e172]: ，\n            - text: T1200级也在研发攻关中\n            - generic [ref=e174]: ，\n            - text: 技术储备一直在推进\n            - generic [ref=e176]: ，\n            - text: 只是短期板块情绪影响了资金偏好\n            - generic [ref=e177]: 。\n            - text: 说到底\n            - generic [ref=e179]: ，\n            - text: 华阳是少有的既有煤炭主业增量明确\n            - generic [ref=e181]: 、\n            - text: 资源储备充足\n            - generic [ref=e183]: ，\n            - text: 又有碳纤维高端赛道布局的标的\n            - generic [ref=e185]: ，\n            - text: 基本面摆在这\n            - generic [ref=e187]: ，\n            - text: 今天的调整只是短期资金博弈的结果\n            - generic [ref=e189]: ，\n            - text: 洗盘过后反而更健康\n            - generic [ref=e191]: 。\n            - text: 耐心持有就好\n            - generic [ref=e193]: ，\n            - text: 静待基本面兑现\n            - generic [ref=e195]: ，\n            - text: 花开终有时\n            - generic [ref=e196]: ！\n            - text: 也想听听各位股友的看法～\n        - paragraph [ref=e197]: 风险提示：用户发表的所有文章仅代表个人观点，与雪球的立场无关。投资决策需建立在独立思考之上。\n        - generic [ref=e200]:\n          - generic [ref=e201] [cursor=pointer]:\n            - generic [ref=e202]: \n            - generic [ref=e204]: \"9\"\n          - generic [ref=e205] [cursor=pointer]:\n            - generic [ref=e206]: \n            - generic [ref=e208]: 收藏\n        - generic [ref=e210]:\n          - img \"微信分享\" [ref=e214] [cursor=pointer]\n          - generic [ref=e215]:\n            - link \" 1\" [ref=e216] [cursor=pointer]:\n              - /url: \"#\"\n              - generic [ref=e217]: \n              - paragraph [ref=e218]: \"1\"\n            - link \" 8\" [ref=e219] [cursor=pointer]:\n              - /url: \"#\"\n              - generic [ref=e220]: \n              - paragraph [ref=e221]: \"8\"\n          - link \"投诉\" [ref=e224] [cursor=pointer]:\n            - /url: \"\"\n            - paragraph [ref=e225]: 投诉\n        - generic [ref=e227]:\n          - generic [ref=e228]:\n            - img [ref=e229]\n            - generic [ref=e230]:\n              - generic [ref=e231]:\n                - generic [ref=e232]: 回复@天时地利的迷信\n                - textbox [ref=e233]:\n                  - paragraph [ref=e234]\n              - generic [ref=e235]:\n                - generic [ref=e236]:\n                  - link \"\" [ref=e238] [cursor=pointer]:\n                    - /url: \"\"\n                    - generic [ref=e239]: \n                  - link \"\" [ref=e240] [cursor=pointer]:\n                    - /url: \"\"\n                    - generic [ref=e241]: \n                  - link \"\" [ref=e242] [cursor=pointer]:\n                    - /url: javascript:;\n                    - generic [ref=e243]: \n                  - generic [ref=e245]:\n                    - checkbox \"仅在正文下讨论\" [ref=e246]\n                    - generic [ref=e247]: 仅在正文下讨论\n                    - img [ref=e249]\n                - link \"发布\" [ref=e251]:\n                  - /url: \"\"\n          - generic [ref=e254]:\n            - heading \"全部讨论（8）\" [level=3] [ref=e255]\n            - generic [ref=e256]:\n              - link \"最热\" [ref=e257] [cursor=pointer]:\n                - /url: \"\"\n              - link \"最新\" [ref=e258] [cursor=pointer]:\n                - /url: \"\"\n              - link \"最早\" [ref=e259] [cursor=pointer]:\n                - /url: \"\"\n            - generic [ref=e261]:\n              - generic [ref=e262]:\n                - link [ref=e263] [cursor=pointer]:\n                  - /url: /7858285844\n                  - img [ref=e264]\n                - generic [ref=e265]:\n                  - generic [ref=e266]:\n                    - link \"不懂投资的大孩\" [ref=e267] [cursor=pointer]:\n                      - /url: /7858285844\n                    - generic [ref=e268]: 02-04 12:00 · 广东\n                  - paragraph [ref=e269]:\n                    - link \"$华阳股份(SH600348)$\" [ref=e270] [cursor=pointer]:\n                      - /url: https://xueqiu.com/S/SH600348\n                    - link \"$中国神华(SH601088)$\" [ref=e271] [cursor=pointer]:\n                      - /url: https://xueqiu.com/S/SH601088\n                    - link \"$煤炭ETF(SH515220)$\" [ref=e272] [cursor=pointer]:\n                      - /url: https://xueqiu.com/S/SH515220\n                    - text: 大家有时候看我很情绪化，也很着急，其实这是行为艺术的表演。\n                    - text: 我可以肯定，在所有华阳股份的股东里，没有几个人有我的定力和耐心！今天上午涨幅在整个煤炭行业中虽倒数第一，但我不care,因为短期波动无法判断，说不定下午直接拉涨停也说不清楚。\n                    - text: 但有点可以肯定，华阳股份是整个煤炭板块中唯一能让投资者有更大希望感、未来感，以及更多在新质科技生产力领域更多的可能性，有更大创造力和想象力的投资标的。\n                    - text: 最关键的是不是概念，不是故事，而是已经成为在建和投产的事实，下一步就是升级、扩产和更大商业化落地，所以对其拥有美好的未来丝毫没有任何怀疑！\n                    - text: 长期看，没有任何人、机构可以阻止其向上的趋势，这是规律的力量。\n                    - text: 这些年我见过太多机构的朋友对很多大牛股都误判过，所以不要相信什么主力资金有什么能耐，能阻挡一时，长期也是无能为力。\n                    - text: 所以大家对华子不要灰心丧气，更要拿出勇创辉煌的信心，拭目以待！\n              - blockquote [ref=e273]:\n                - generic [ref=e274]:\n                  - link \"不懂投资的大孩\" [ref=e275] [cursor=pointer]:\n                    - /url: /7858285844\n                  - text: 回复\n                  - link \"@用户8235026220\" [ref=e276] [cursor=pointer]:\n                    - /url: /8235026220\n                  - text: ：\n                  - generic [ref=e277] [cursor=pointer]:\n                    - link \"$华阳股份(SH600348)$\" [ref=e278]:\n                      - /url: https://xueqiu.com/S/SH600348\n                    - text: 目前我在华子是8位数，如果我有几个九位数，早就把它拉上起飞🛫先上10元这个平台。我的策略就是让所有做差价波段，做T的通通踏空，以我对旅鼠们的了解，因为他们迟早会以更高价追买或买回来的。\n                    - img \"[大笑]\" [ref=e279]\n                    - img \"[大笑]\" [ref=e280]\n                - generic [ref=e281]:\n                  - link \"天时地利的迷信 作者\" [ref=e282] [cursor=pointer]:\n                    - /url: /5644376051\n                  - text: ：如果有大主力的操盘手，确实会这样做是最好的，因为一个涨停价破四年新高，会吸引包括量化在内的很多资金的关注，以后就可以涨得更快。但是前几年华阳股份的投资者管理做得非常非常之糟糕。跟一些煤炭板块的就是分析师，还有一些机构投资者都沟通过。原因，是因为那个就是有一个谣言。有机构打电话...\n                  - link \"展开\" [ref=e283] [cursor=pointer]:\n                    - /url: \"\"\n                - generic [ref=e284]:\n                  - link \"圣安妮塔的螺丝起子\" [ref=e285] [cursor=pointer]:\n                    - /url: /5803741784\n                  - text: 回复\n                  - link \"@天时地利的迷信\" [ref=e286] [cursor=pointer]:\n                    - /url: /5644376051\n                  - text: ：\n                  - generic [ref=e287] [cursor=pointer]:\n                    - text: 哎呀这老西儿，话都不会好好讲\n                    - img \"[呲牙]\" [ref=e288]\n                - generic [ref=e289]:\n                  - link \"圣安妮塔的螺丝起子\" [ref=e290] [cursor=pointer]:\n                    - /url: /5803741784\n                  - text: ：\n                  - generic [ref=e291] [cursor=pointer]:\n                    - img \"[呲牙]\" [ref=e292]\n                    - img \"[呲牙]\" [ref=e293]\n                    - text: 大孩儿，你还是蛮好玩的\n                    - img \"[牛]\" [ref=e294]\n                    - text: 。\n                - generic [ref=e295]:\n                  - link \"天时地利的迷信 作者\" [ref=e296] [cursor=pointer]:\n                    - /url: /5644376051\n                  - text: ：前面几年，华阳的投资者关系都做得极其差。哎，就是很难想象的差。然后反现在好一点了，但是呢，就是跟潞安环能、中国神华啊，这些完全没办法比。\n                - generic [ref=e297]: 查看7条回复\n              - generic [ref=e298]:\n                - link \"7\" [ref=e299] [cursor=pointer]:\n                  - /url: \"\"\n                - link \"6\" [ref=e300] [cursor=pointer]:\n                  - /url: \"\"\n      - generic [ref=e302]:\n        - generic [ref=e303]:\n          - heading \"热门话题\" [level=3] [ref=e304]\n          - table [ref=e306]:\n            - row \"1 化工板块强势攀升，金牛化工封涨停板\" [ref=e307]:\n              - cell \"1\" [ref=e308]\n              - cell \"化工板块强势攀升，金牛化工封涨停板\" [ref=e309]:\n                - link \"化工板块强势攀升，金牛化工封涨停板\" [ref=e310] [cursor=pointer]:\n                  - /url: /k?q=%23%E5%8C%96%E5%B7%A5%E6%9D%BF%E5%9D%97%E5%BC%BA%E5%8A%BF%E6%94%80%E5%8D%87%EF%BC%8C%E9%87%91%E7%89%9B%E5%8C%96%E5%B7%A5%E5%B0%81%E6%B6%A8%E5%81%9C%E6%9D%BF%23\n            - row \"2 首只中证红利质量ETF成立一周年\" [ref=e311]:\n              - cell \"2\" [ref=e312]\n              - cell \"首只中证红利质量ETF成立一周年\" [ref=e313]:\n                - link \"首只中证红利质量ETF成立一周年\" [ref=e314] [cursor=pointer]:\n                  - /url: /k?q=%23%E9%A6%96%E5%8F%AA%E4%B8%AD%E8%AF%81%E7%BA%A2%E5%88%A9%E8%B4%A8%E9%87%8FETF%E6%88%90%E7%AB%8B%E4%B8%80%E5%91%A8%E5%B9%B4%23\n            - row \"3 煤炭板块大涨，中煤能源涨停\" [ref=e315]:\n              - cell \"3\" [ref=e316]\n              - cell \"煤炭板块大涨，中煤能源涨停\" [ref=e317]:\n                - link \"煤炭板块大涨，中煤能源涨停\" [ref=e318] [cursor=pointer]:\n                  - /url: /k?q=%23%E7%85%A4%E7%82%AD%E6%9D%BF%E5%9D%97%E5%A4%A7%E6%B6%A8%EF%BC%8C%E4%B8%AD%E7%85%A4%E8%83%BD%E6%BA%90%E6%B6%A8%E5%81%9C%23\n            - row \"4 绿电概念走强，绿发电力涨停\" [ref=e319]:\n              - cell \"4\" [ref=e320]\n              - cell \"绿电概念走强，绿发电力涨停\" [ref=e321]:\n                - link \"绿电概念走强，绿发电力涨停\" [ref=e322] [cursor=pointer]:\n                  - /url: /k?q=%23%E7%BB%BF%E7%94%B5%E6%A6%82%E5%BF%B5%E8%B5%B0%E5%BC%BA%EF%BC%8C%E7%BB%BF%E5%8F%91%E7%94%B5%E5%8A%9B%E6%B6%A8%E5%81%9C%23\n            - row \"5 MicroLED概念拉升，华灿光电大涨\" [ref
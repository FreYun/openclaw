{"type":"message","id":"a221b920","parentId":"4144c972","timestamp":"2026-03-11T07:37:17.507Z","message":{"role":"toolResult","toolCallId":"toolu_01HaDqLd18wUidKSto7Wzs5d","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\nimport base64\nimport json\nimport requests\n\nBASE_URL = \"http://localhost:18061\"\n\n# 初始化 MCP Session\nresp = requests.post(\n    f\"{BASE_URL}/mcp\",\n    json={\n        \"jsonrpc\": \"2.0\",\n        \"id\": 1,\n        \"method\": \"initialize\",\n        \"params\": {\n            \"protocolVersion\": \"2025-03-26\",\n            \"capabilities\": {},\n            \"clientInfo\": {\"name\": \"get-qrcode\", \"version\": \"1.0\"},\n        },\n    },\n    timeout=15,\n)\nresp.raise_for_status()\nsession_id = resp.headers.get(\"Mcp-Session-Id\")\nprint(f\"Session ID: {session_id}\")\n\n# 调用 get_login_qrcode\nresp = requests.post(\n    f\"{BASE_URL}/mcp\",\n    headers={\"Mcp-Session-Id\": session_id},\n    json={\n        \"jsonrpc\": \"2.0\",\n        \"id\": 2,\n        \"method\": \"tools/call\",\n        \"params\": {\"name\": \"get_login_qrcode\", \"arguments\": {\"account_id\": \"bot1\"}},\n    },\n    timeout=60,\n)\nresp.raise_for_status()\ndata = resp.json()\nprint(json.dumps(data, indent=2))\n\nif \"error\" in data:\n    print(f\"Error: {data['error']}\")\n    exit(1)\n\nresult = data.get(\"result\", {})\nimage_data = \"\"\nfor item in result.get(\"content\", []):\n    if item.get(\"type\") == \"image\":\n        image_data = item.get(\"data\", \"\")\n        break\n\nif not image_data:\n    print(\"No image data found\")\n    exit(1)\n\n# 解码并保存\nif \",\" in image_data and image_data.startswith(\"data:\"):\n    image_data = image_data.split(\",\", 1)[1]\n\nraw = base64.b64decode(image_data)\noutput_path = \"/home/rooot/.openclaw/media/xhs-qrcode-bot1.png\"\nwith open(output_path, \"wb\") as f:\n    f.write(raw)\n\nprint(f\"QR code saved to: {output_path}\")\n"}],"isError":false,"timestamp":1773214637503}}
